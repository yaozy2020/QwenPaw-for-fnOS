{
  "name": "qwenpaw-console",
  "private": true,
  "type": "module",
  "description": "QwenPaw for fnOS 控制台前端源码;Vue 3 + Vite 编译为单文件 dist/index.html(app/www 运行时契约不变)",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:gateway": "node e2e/run.mjs",
    "test:e2e:gateway:webkit": "node e2e/run.mjs --engine=webkit",
    "test:e2e:help": "node e2e/run.mjs --help"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "@trimjs/web-app": "^0.5.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  }
}
