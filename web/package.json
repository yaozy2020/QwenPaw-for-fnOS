{
  "name": "qwenpaw-console",
  "private": true,
  "type": "module",
  "description": "QwenPaw for fnOS 控制台前端源码;esbuild 编译为单文件 dist/index.html(app/www 运行时契约不变)",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:gateway": "node e2e/run.mjs",
    "test:e2e:gateway:webkit": "node e2e/run.mjs --engine=webkit",
    "test:e2e:help": "node e2e/run.mjs --help"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "0.25.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@trimjs/web-app": "^0.5.0",
    "preact": "^11.1.1"
  }
}
