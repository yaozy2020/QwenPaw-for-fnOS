new file mode 100644
index 0000000000000000000000000000000000000000..e48125f6849813fddd493abab6704a1ada0ccf18
--- /dev/null
+++ b/console/scripts/bounded-preload.test.ts
@@ -0,0 +1,71 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+beforeEach(() => {
+  document.head.innerHTML = "";
+  vi.resetModules();
+  vi.spyOn(DOMTokenList.prototype, "supports").mockReturnValue(true);
+});
+
+describe("bounded Console preloading", () => {
+  it("bounds simultaneous loads across imports, deduplicates dependencies and waits before importing", async () => {
+    const { __vitePreload, PRELOAD_CONCURRENCY } = await import(
+      "./bounded-preload"
+    );
+    const factory = vi.fn(async () => "loaded");
+    const dependencies = Array.from(
+      { length: 40 },
+      (_, i) => `/assets/${i}.js`,
+    );
+    const first = __vitePreload(factory, dependencies, location.href);
+    const second = __vitePreload(factory, dependencies, location.href);
+    expect(document.querySelectorAll("link")).toHaveLength(PRELOAD_CONCURRENCY);
+    expect(factory).not.toHaveBeenCalled();
+    let completed = 0;
+    const seen = new Set<Element>();
+    while (completed < dependencies.length) {
+      for (const link of document.querySelectorAll("link")) {
+        if (seen.has(link)) continue;
+        seen.add(link);
+        link.dispatchEvent(new Event("load"));
+        completed += 1;
+      }
+      await new Promise((resolve) => setTimeout(resolve, 0));
+      expect(
+        document.querySelectorAll("link").length - completed,
+      ).toBeLessThanOrEqual(PRELOAD_CONCURRENCY);
+    }
+    await expect(first).resolves.toBe("loaded");
+    await expect(second).resolves.toBe("loaded");
+    expect(document.querySelectorAll("link")).toHaveLength(40);
+    expect(factory).toHaveBeenCalledTimes(2);
+  });
+
+  it("preserves prefix resolution, stylesheets and CSP nonces", async () => {
+    document.head.innerHTML =
+      '<meta property="csp-nonce" nonce="example-nonce">';
+    const { __vitePreload } = await import("./bounded-preload");
+    const result = __vitePreload(
+      async () => 7,
+      ["./style.css"],
+      "https://example.org/app/qwenpaw/web/main.js",
+    );
+    const link = document.querySelector("link")!;
+    expect(link.href).toBe("https://example.org/app/qwenpaw/web/style.css");
+    expect(link.rel).toBe("stylesheet");
+    expect(link.nonce).toBe("example-nonce");
+    link.dispatchEvent(new Event("load"));
+    await expect(result).resolves.toBe(7);
+  });
+
+  it("does not run the importer after a failed preload and reports Vite's recovery event", async () => {
+    const { __vitePreload } = await import("./bounded-preload");
+    const listener = vi.fn();
+    window.addEventListener("vite:preloadError", listener, { once: true });
+    const factory = vi.fn();
+    const result = __vitePreload(factory, ["/assets/broken.js"], location.href);
+    document.querySelector("link")!.dispatchEvent(new Event("error"));
+    await expect(result).rejects.toMatchObject({ name: "ChunkLoadError" });
+    expect(listener).toHaveBeenCalledOnce();
+    expect(factory).not.toHaveBeenCalled();
+  });
+});
diff --git a/console/scripts/bounded-preload.ts b/console/scripts/bounded-preload.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a9aca34b13048ee603fc3671f846b7511bb76f3e
--- /dev/null
+++ b/console/scripts/bounded-preload.ts
@@ -0,0 +1,71 @@
+export const PRELOAD_CONCURRENCY = 16;
+const pending = new Map<string, Promise<void>>();
+const waiting: (() => void)[] = [];
+let active = 0;
+
+function pump(): void {
+  while (active < PRELOAD_CONCURRENCY && waiting.length) {
+    active += 1;
+    waiting.shift()!();
+  }
+}
+
+function preload(dependency: string, importerUrl: string): Promise<void> {
+  const href = new URL(dependency, importerUrl).href;
+  const existing = pending.get(href);
+  if (existing) return existing;
+  const css = new URL(href).pathname.endsWith(".css");
+  if (
+    !css &&
+    !document.createElement("link").relList.supports("modulepreload")
+  ) {
+    return Promise.resolve();
+  }
+  const result = new Promise<void>((resolve, reject) => {
+    waiting.push(() => {
+      const link = document.createElement("link");
+      const finish = (error?: Error) => {
+        active -= 1;
+        link.onload = link.onerror = null;
+        if (error) reject(error);
+        else resolve();
+        pump();
+      };
+      link.rel = css ? "stylesheet" : "modulepreload";
+      link.crossOrigin = "";
+      link.href = href;
+      const nonce = document.querySelector<HTMLMetaElement>(
+        'meta[property="csp-nonce"]',
+      )?.nonce;
+      if (nonce) link.nonce = nonce;
+      link.onload = () => finish();
+      link.onerror = () => {
+        const error = new Error(`Unable to preload ${href}`);
+        error.name = "ChunkLoadError";
+        finish(error);
+      };
+      document.head.appendChild(link);
+    });
+    pump();
+  });
+  pending.set(href, result);
+  return result;
+}
+
+export async function __vitePreload<T>(
+  importer: () => Promise<T>,
+  dependencies: string[] = [],
+  importerUrl = document.baseURI,
+): Promise<T | undefined> {
+  try {
+    await Promise.all(
+      dependencies.map((dependency) => preload(dependency, importerUrl)),
+    );
+    return await importer();
+  } catch (error) {
+    const event = new Event("vite:preloadError", { cancelable: true });
+    Object.assign(event, { payload: error });
+    window.dispatchEvent(event);
+    if (!event.defaultPrevented) throw error;
+  }
+}
