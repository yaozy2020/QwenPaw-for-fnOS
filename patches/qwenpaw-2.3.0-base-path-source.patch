--- /dev/null
+++ b/console/scripts/dev-api-proxy.test.ts
@@ -0,0 +1,42 @@
+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+import { describe, expect, it } from "vitest";
+
+const runNode = promisify(execFile);
+// Load the actual config in Node: esbuild cannot run in jsdom's realm.
+const script = `
+  import { loadConfigFromFile } from "vite";
+  const loaded = await loadConfigFromFile(
+    { command: "serve", mode: "development" }, "vite.config.ts",
+  );
+  process.stdout.write(JSON.stringify({
+    proxy: loaded?.config.server?.proxy?.["/api"],
+    definedBase: loaded?.config.define?.VITE_API_BASE_URL,
+  }));
+`;
+
+describe("development API proxy", () => {
+  it.each([
+    ["http://localhost:8001", "http://localhost:8001"],
+    ["http://127.0.0.1:8001", "http://127.0.0.1:8001"],
+    ["https://api.example.test", "https://api.example.test"],
+    ["http://localhost:8001/backend", "http://localhost:8001/backend"],
+    ["", "http://localhost:8088"],
+    ["/backend", "http://localhost:8088"],
+  ])("uses the configured backend for %j", async (base, target) => {
+    const { stdout } = await runNode(
+      process.execPath,
+      ["--input-type=module", "-e", script],
+      {
+        cwd: process.cwd(),
+        env: { ...process.env, VITE_API_BASE_URL: base },
+      },
+    );
+    const loaded = JSON.parse(stdout);
+    expect(loaded.proxy).toMatchObject({
+      target,
+      changeOrigin: false,
+    });
+    expect(loaded.definedBase).toBe(JSON.stringify(base));
+  });
+});
diff --git a/console/scripts/initial-bundle.mjs b/console/scripts/initial-bundle.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..899d0f32b8f5cbdd565165f1e6d3210fab2d513e
--- /dev/null
+++ b/console/scripts/initial-bundle.mjs
@@ -0,0 +1,86 @@
+import { readFile, stat } from "node:fs/promises";
+import { join } from "node:path";
+
+/** Measure the entry's static imports and CSS using Vite's emitted graph. */
+export async function measureInitialBundle(outputDirectory) {
+  const manifest = JSON.parse(
+    await readFile(join(outputDirectory, ".vite", "manifest.json"), "utf8"),
+  );
+  const assets = new Set();
+  const visited = new Set();
+  const active = [];
+
+  function visit(key) {
+    if (active.includes(key)) {
+      const cycle = [...active.slice(active.indexOf(key)), key];
+      throw new Error(
+        `Initial JavaScript import cycle: ${cycle
+          .map((entry) => manifest[entry].file)
+          .join(" -> ")}`,
+      );
+    }
+    if (visited.has(key)) return;
+    const chunk = manifest[key];
+    if (!chunk) throw new Error(`Missing manifest entry: ${key}`);
+    visited.add(key);
+    active.push(key);
+    assets.add(chunk.file);
+    for (const css of chunk.css ?? []) assets.add(css);
+    // dynamicImports are intentionally excluded: they are separate budgets.
+    for (const dependency of chunk.imports ?? []) visit(dependency);
+    active.pop();
+  }
+
+  visit("index.html");
+  const sizes = await Promise.all(
+    [...assets].map(async (file) => {
+      const path = join(outputDirectory, file);
+      const rawBytes = (await stat(path)).size;
+      let brotliBytes = rawBytes;
+      let compressed = false;
+      try {
+        brotliBytes = (await stat(`${path}.br`)).size;
+        compressed = true;
+      } catch (error) {
+        if (error?.code !== "ENOENT") throw error;
+      }
+      return { file, rawBytes, brotliBytes, compressed };
+    }),
+  );
+  sizes.sort((left, right) => right.rawBytes - left.rawBytes);
+  return {
+    assets: sizes,
+    rawBytes: sizes.reduce((sum, asset) => sum + asset.rawBytes, 0),
+    brotliBytes: sizes.reduce((sum, asset) => sum + asset.brotliBytes, 0),
+  };
+}
+
+/** Return all budget violations so CI names each regressing asset. */
+export function checkInitialBundle(report, budgets) {
+  const failures = [];
+  if (report.rawBytes > budgets.rawBytes) {
+    failures.push("Initial raw bundle exceeds budget.");
+  }
+  if (report.brotliBytes > budgets.brotliBytes) {
+    failures.push("Initial Brotli bundle exceeds budget.");
+  }
+  for (const asset of report.assets) {
+    if (asset.file.endsWith(".js") && asset.rawBytes > budgets.chunkRawBytes) {
+      failures.push(`${asset.file} exceeds the JavaScript chunk raw budget.`);
+    }
+    if (
+      asset.file.endsWith(".js") &&
+      asset.brotliBytes > budgets.chunkBrotliBytes
+    ) {
+      failures.push(
+        `${asset.file} exceeds the JavaScript chunk Brotli budget.`,
+      );
+    }
+    if (
+      budgets.lazyOnly.some((name) => asset.file.startsWith(`assets/${name}-`))
+    ) {
+      failures.push(`${asset.file} must remain outside the initial bundle.`);
+    }
+  }
+  return failures;
+}
diff --git a/console/scripts/initial-bundle.test.ts b/console/scripts/initial-bundle.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d21d92b3cd9488ab7201593076d95ce5c565d28d
--- /dev/null
+++ b/console/scripts/initial-bundle.test.ts
@@ -0,0 +1,135 @@
+import { mkdtemp, mkdir, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { checkInitialBundle, measureInitialBundle } from "./initial-bundle.mjs";
+
+const directories: string[] = [];
+
+async function fixture(manifest: Record<string, unknown>) {
+  const directory = await mkdtemp(join(tmpdir(), "qwenpaw-bundle-"));
+  directories.push(directory);
+  await mkdir(join(directory, ".vite"));
+  await mkdir(join(directory, "assets"));
+  await writeFile(
+    join(directory, ".vite", "manifest.json"),
+    JSON.stringify(manifest),
+  );
+  return directory;
+}
+
+afterEach(async () => {
+  await Promise.all(
+    directories
+      .splice(0)
+      .map((directory) => rm(directory, { recursive: true })),
+  );
+});
+
+describe("initial bundle static closure", () => {
+  it("counts transitive imports and shared CSS once, excluding dynamic imports", async () => {
+    const directory = await fixture({
+      "index.html": {
+        file: "assets/index.js",
+        imports: ["shell", "shared"],
+        dynamicImports: ["charts"],
+        css: ["assets/index.css"],
+      },
+      shell: { file: "assets/shell.js", imports: ["shared"] },
+      shared: { file: "assets/shared.js", css: ["assets/index.css"] },
+      charts: { file: "assets/charts.js", imports: ["index.html"] },
+    });
+    for (const file of ["index.js", "shell.js", "shared.js", "index.css"]) {
+      await writeFile(join(directory, "assets", file), "1234567890");
+      await writeFile(join(directory, "assets", `${file}.br`), "123");
+    }
+    // Public base paths do not affect the manifest's output-relative paths.
+    await writeFile(
+      join(directory, "index.html"),
+      '<script type="module" src="/nested/console/assets/index.js"></script>',
+    );
+    const report = await measureInitialBundle(directory);
+    expect(report.assets).toHaveLength(4);
+    expect(report.rawBytes).toBe(40);
+    expect(report.brotliBytes).toBe(12);
+  });
+
+  it("finds a static cycle outside the HTML's direct preload list", async () => {
+    const directory = await fixture({
+      "index.html": { file: "assets/index.js", imports: ["a"] },
+      a: { file: "assets/a.js", imports: ["b"] },
+      b: { file: "assets/b.js", imports: ["a"] },
+    });
+    await expect(measureInitialBundle(directory)).rejects.toThrow(
+      "assets/a.js -> assets/b.js -> assets/a.js",
+    );
+  });
+
+  it("fails for missing manifest dependencies instead of undercounting", async () => {
+    const directory = await fixture({
+      "index.html": { file: "assets/index.js", imports: ["missing"] },
+    });
+    await expect(measureInitialBundle(directory)).rejects.toThrow(
+      "Missing manifest entry: missing",
+    );
+  });
+
+  it("uses raw bytes conservatively when precompression is absent", async () => {
+    const directory = await fixture({
+      "index.html": { file: "assets/index.js" },
+    });
+    await writeFile(join(directory, "assets", "index.js"), "12345");
+    const report = await measureInitialBundle(directory);
+    expect(report.brotliBytes).toBe(5);
+    expect(report.assets[0].compressed).toBe(false);
+  });
+
+  it("fails if a required emitted asset is missing", async () => {
+    const directory = await fixture({
+      "index.html": { file: "assets/missing.js" },
+    });
+    await expect(measureInitialBundle(directory)).rejects.toThrow("ENOENT");
+  });
+});
+
+describe("initial bundle budgets", () => {
+  const budgets = {
+    rawBytes: 100,
+    brotliBytes: 50,
+    chunkRawBytes: 80,
+    chunkBrotliBytes: 40,
+    lazyOnly: ["charts-vendor"],
+  };
+
+  it("allows totals and chunks exactly on their limits", () => {
+    expect(
+      checkInitialBundle(
+        {
+          rawBytes: 100,
+          brotliBytes: 50,
+          assets: [{ file: "assets/ui.js", rawBytes: 80, brotliBytes: 40 }],
+        },
+        budgets,
+      ),
+    ).toEqual([]);
+  });
+
+  it("reports total, per-chunk, and lazy dependency regressions together", () => {
+    const failures = checkInitialBundle(
+      {
+        rawBytes: 101,
+        brotliBytes: 51,
+        assets: [
+          {
+            file: "assets/charts-vendor-hash.js",
+            rawBytes: 81,
+            brotliBytes: 41,
+          },
+        ],
+      },
+      budgets,
+    );
+    expect(failures).toHaveLength(5);
+    expect(failures.join(" ")).toContain("charts-vendor-hash.js");
+  });
+});
diff --git a/console/scripts/startup-monitor-plugin.test.ts b/console/scripts/startup-monitor-plugin.test.ts
