+import { cleanup, render, screen } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const backendInfoMock = vi.hoisted(() => vi.fn());
+const pluginProviderMock = vi.hoisted(() => vi.fn());
+
+vi.mock("./auth/gate", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("./auth/gate")>();
+  return { ...actual, resolveBackendInfo: backendInfoMock };
+});
+vi.mock("@agentscope-ai/design", () => ({
+  ConfigProvider: ({ children }: { children: React.ReactNode }) => children,
+  bailianDarkTheme: { theme: {} },
+  bailianTheme: { theme: {} },
+}));
+vi.mock("react-i18next", () => ({
+  useTranslation: () => ({
+    t: (key: string) => key,
+    i18n: { language: "en", resolvedLanguage: "en" },
+  }),
+}));
+vi.mock("./contexts/ThemeContext", () => ({
+  useTheme: () => ({ isDark: false, previewTheme: {} }),
+}));
+vi.mock("./api/modules/language", () => ({
+  languageApi: { getLanguage: vi.fn().mockResolvedValue({ language: "en" }) },
+}));
+vi.mock("./stores/uploadLimitStore", () => ({
+  useUploadLimitStore: { getState: () => ({ fetch: vi.fn() }) },
+}));
+vi.mock("./plugins/PluginContext", () => ({
+  PluginProvider: ({ children }: { children: React.ReactNode }) => {
+    pluginProviderMock();
+    return <>{children}</>;
+  },
+}));
+vi.mock("./pages/Login/index", () => ({
+  default: () => <div>login page</div>,
+}));
+vi.mock("./layouts/MainLayout", () => ({
+  default: () => <div>main application</div>,
+}));
+vi.mock("./components/UpdateTakeoverPage", () => ({
+  UpdateTakeoverGate: ({ children }: { children: React.ReactNode }) => children,
+}));
+
+import App from "./App";
+
+describe("Console plugin startup boundary", () => {
+  beforeEach(() => {
+    backendInfoMock.mockResolvedValue({
+      mode: "standard",
+      authStatus: { enabled: false, has_users: true },
+    });
+  });
+
+  afterEach(() => {
+    cleanup();
+    vi.clearAllMocks();
+  });
+
+  it("does not initialize chat plugins on the login page", async () => {
+    window.history.replaceState({}, "", "/login");
+    render(<App />);
+
+    expect(await screen.findByText("login page")).toBeInTheDocument();
+    expect(pluginProviderMock).not.toHaveBeenCalled();
+  });
+
+  it("initializes plugins for the protected main application", async () => {
+    window.history.replaceState({}, "", "/chat");
+    render(<App />);
+
+    expect(await screen.findByText("main application")).toBeInTheDocument();
+    expect(pluginProviderMock).toHaveBeenCalled();
+  });
+});
