#!/bin/bash
# 飞牛运行设置初始化：回显当前生效的端口与日志级别配置
PKGVAR="${TRIM_PKGVAR:-/var/apps/qwenpaw/var}"
PORT_FILE="${PKGVAR}/service_port"

# 默认端口与 install_callback/lib.sh 的全局默认一致(18088;19091 是历史冲突口)
current_port="18088"
if [ -f "${PORT_FILE}" ]; then
    p=$(head -n 1 "${PORT_FILE}" | tr -d '[:space:]')
    [ -n "$p" ] && current_port="$p"
fi

# 回显日志级别:从落盘文件读取,对齐 wizard/config 中的 wizard_log_level 字段。
# 向导只提供 info/debug/warning/error 四档;落盘值若为 trace/critical(旧版或手工写入),
# 不能静默改写成 debug/error —— 那会让用户在设置面板看到与实际生效不同的值,
# 改完保存还会把真实级别永久覆盖。这里按"能原样回显就原样回显"处理:
# 落在向导选项内的照抄,向导没有的旧值映射到最接近的档位,同时把真实值写进日志。
current_level="info"
LEVEL_FILE="${PKGVAR}/qwenpaw-log-level"
if [ -f "${LEVEL_FILE}" ]; then
    l=$(head -n 1 "${LEVEL_FILE}" | tr -d '[:space:]')
    case "$l" in
        error|warning|info|debug)
            current_level="$l"
            ;;
        trace)
            # 旧版 trace 比 debug 更细,面板只能选 debug;不改动落盘值,仅提示
            current_level="debug"
            echo "[config_init] 落盘日志级别为 trace(向导无此档),面板回显为 debug;未改动落盘值" >&2
            ;;
        critical)
            current_level="error"
            echo "[config_init] 落盘日志级别为 critical(向导无此档),面板回显为 error;未改动落盘值" >&2
            ;;
        "")
            ;;
        *)
            echo "[config_init] 落盘日志级别 '${l}' 不在白名单,回显默认值 info" >&2
            ;;
    esac
fi

# 飞牛向导初始化语法:回显必须匹配向导中的 field 名称(wizard_port 与 wizard_log_level)
# 同时保留 service_port 兼容历史读取
echo "wizard_port=${current_port}"
echo "service_port=${current_port}"
echo "wizard_log_level=${current_level}"
exit 0
