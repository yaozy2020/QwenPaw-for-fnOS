#!/bin/bash
# 飞牛卸载回调脚本：对齐 DSH 安全数据治理标准
# 不用 set -e（工程铁律）；停止走统一 supervisor.pid 口径（旧 qwenpaw.pid 已废弃）

APPNAME="qwenpaw"
WORKING_DIR="${TRIM_PKGHOME:-/var/apps/qwenpaw/home}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/qwenpaw/var}"
PKGETC="${TRIM_PKGETC:-/var/apps/qwenpaw/etc}"
SHARE_DIR="${TRIM_DATA_SHARE_PATHS%%:*}/.qwenpaw"
[ -z "${TRIM_DATA_SHARE_PATHS}" ] && SHARE_DIR="/vol2/@appshare/qwenpaw"

LOG_FILE="${PKGVAR}/qwenpaw-uninstall.log"
KEEP_DATA="${wizard_keep_data:-keep}"

log_msg() {
    mkdir -p "${PKGVAR}" 2>/dev/null || true
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}" 2>/dev/null || true
}

log_msg "开始执行 QwenPaw 卸载流程..."

# 1. 停止运行中的进程:统一 supervisor.pid 口径(监督者 TERM 会级联停内核并
#    回收安装中的 pip;旧 qwenpaw.pid 从未被当前版本写入,仅为兼容清理)
PID_FILE="${PKGVAR}/supervisor.pid"
if [ -f "${PID_FILE}" ]; then
    pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        log_msg "正在终止监督者 PID: ${pid}(级联停内核)..."
        kill -TERM "${pid}" 2>/dev/null || true
        count=0
        while kill -0 "${pid}" 2>/dev/null && [ $count -lt 15 ]; do
            sleep 1
            count=$((count + 1))
        done
        kill -KILL "${pid}" 2>/dev/null || true
    fi
    rm -f "${PID_FILE}" 2>/dev/null || true
fi
rm -f "${PKGVAR}/qwenpaw.pid" 2>/dev/null || true

# 2. 根据用户向导选择处理数据
case "${KEEP_DATA}" in
keep | yes | true | 1)
    log_msg "用户选择保留应用数据，工作区与记忆完整保留。"
    rm -rf "${WORKING_DIR}/venv" 2>/dev/null || true
    ;;
remove | no | false | 0)
    log_msg "用户选择彻底删除应用数据，正在清理所有目录..."
    rm -rf "${WORKING_DIR}" 2>/dev/null || true
    rm -rf "${PKGETC}" 2>/dev/null || true
    rm -rf "${SHARE_DIR}" 2>/dev/null || true
    rm -rf "/vol2/@appshare/qwenpaw" 2>/dev/null || true
    rm -rf "${PKGVAR}" 2>/dev/null || true
    ;;
*)
    log_msg "未知的 wizard_keep_data 选项: ${KEEP_DATA}，默认采取安全保护保留数据"
    ;;
esac

log_msg "QwenPaw 卸载流程执行完毕。"
exit 0
