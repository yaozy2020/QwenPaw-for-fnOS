#!/bin/bash
# 飞牛运行设置修改回调脚本：对齐 DSH 变量规范
set -e

PKGVAR="${TRIM_PKGVAR:-/var/apps/qwenpaw/var}"
APPDEST="${TRIM_APPDEST:-/var/apps/qwenpaw/target}"
[ ! -d "${APPDEST}" ] && APPDEST="/var/apps/qwenpaw"

LOG_FILE="${PKGVAR}/qwenpaw-config.log"
PID_FILE="${PKGVAR}/qwenpaw.pid"
PORT_FILE="${PKGVAR}/service_port"

log_msg() {
    mkdir -p "${PKGVAR}" 2>/dev/null || true
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# 1. 严格使用飞牛标准注入的 wizard_port 变量
NEW_PORT="${wizard_port:-}"

if [ -n "${NEW_PORT}" ] && echo "${NEW_PORT}" | grep -qE '^[0-9]+$' && [ "${NEW_PORT}" -ge 1024 ] && [ "${NEW_PORT}" -le 65535 ]; then
    log_msg "检测到修改 Web 服务端口为: ${NEW_PORT}"
    
    # 持久化备份
    echo "${NEW_PORT}" > "${PORT_FILE}"
    
    # 核心：动态同步改写飞牛系统的 ui/config，彻底解决常规卡片端口不一致问题！
    for ui_cfg in "${APPDEST}/ui/config" "/var/apps/qwenpaw/ui/config"; do
        if [ -w "${ui_cfg}" ]; then
            sed -i 's/"port": *"[0-9]*"/"port": "'"${NEW_PORT}"'"/g' "${ui_cfg}" 2>/dev/null || true
            log_msg "已同步更新 ${ui_cfg} 端口为 ${NEW_PORT}"
        fi
    done
fi

# 2. 优雅重启 QwenPaw 服务
log_msg "正在应用新配置并重启 QwenPaw 服务..."

if [ -f "${PID_FILE}" ]; then
    pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        kill -TERM "${pid}" 2>/dev/null || true
        count=0
        while kill -0 "${pid}" 2>/dev/null && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
        done
        kill -KILL "${pid}" 2>/dev/null || true
    fi
    rm -f "${PID_FILE}"
fi

MAIN_SCRIPT="${APPDEST}/cmd/main"
[ ! -f "${MAIN_SCRIPT}" ] && MAIN_SCRIPT="/var/apps/qwenpaw/cmd/main"

if [ -x "${MAIN_SCRIPT}" ]; then
    wizard_port="${NEW_PORT}" bash "${MAIN_SCRIPT}" start >> "${LOG_FILE}" 2>&1 &
    log_msg "QwenPaw 服务已使用新端口 ${NEW_PORT} 重新拉起"
fi

exit 0
