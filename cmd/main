#!/bin/bash
# fnOS 生命周期入口:本脚本只管理监督者进程;内核生命周期由监督者负责。
# start → 拉起监督者(监督者自动收养/拉起内核)
# stop  → TERM 监督者(监督者收到信号级联停内核)→ 宽限 → KILL
# status→ 监督者存活即应用运行(退出码 0/3,官方约定)

SUP_BIN_CANDIDATES=(
    "${TRIM_APPDEST}/bin/qwenpaw-supervisor"
    "${TRIM_APPDEST}/app/bin/qwenpaw-supervisor"
    "/var/apps/qwenpaw/bin/qwenpaw-supervisor"
)
VAR_DIR="${TRIM_PKGVAR:-/var/apps/qwenpaw/var}"
PID_FILE="${VAR_DIR}/supervisor.pid"
LOG_FILE="${VAR_DIR}/supervisor.log"

SUP_BIN=""
for c in "${SUP_BIN_CANDIDATES[@]}"; do
    if [ -x "$c" ]; then
        SUP_BIN="$c"
        break
    fi
done

start_process() {
    if status; then
        return 0
    fi
    if [ -z "$SUP_BIN" ]; then
        echo "supervisor binary not found" >&2
        return 1
    fi
    # TRIM_* 环境变量由平台注入本脚本,子进程继承;监督者据此定位数据目录
    nohup "$SUP_BIN" >> "${LOG_FILE}" 2>&1 &
    echo $! > "${PID_FILE}"
    return 0
}

stop_process() {
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            # 监督者收到 TERM 会级联停内核(设计 D4),宽限 15s(内核安装进行中时会先完成清扫)
            kill -TERM "${pid}" 2>/dev/null || true
            count=0
            while kill -0 "${pid}" 2>/dev/null && [ $count -lt 15 ]; do
                sleep 1
                count=$((count + 1))
            done
            kill -KILL "${pid}" 2>/dev/null || true
        fi
        rm -f "${PID_FILE}"
    fi
    return 0
}

status() {
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 3
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
