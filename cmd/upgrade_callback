#!/bin/bash
# 飞牛应用覆盖升级回调：仅修复外壳与权限，不改变内核版本（版本双轨制）
# - venv 已存在：内核保持原版本不动，本体升级只走控制台"版本管理"显式操作
# - venv 缺失重建：按 ${VAR_DIR}/qwenpaw-version 版本钉恢复；无钉时按向导渠道安装
# 注意：不用 set -e（工程铁律），失败路径显式 exit 1

PYTHON_BIN="${QWENPAW_PYTHON_BIN:-/var/apps/python312/target/bin/python3}"

# 公共环境与工具函数（路径/运行环境变量/log_msg/内核检测），HOME 为安装态语义
. "$(dirname "$0")/lib.sh"
LIB_LOG_FILE="${VAR_DIR}/qwenpaw-upgrade.log"
PIN_FILE="${VAR_DIR}/qwenpaw-version"
export HOME="${WORKING_DIR}"

log_msg "开始升级 QwenPaw 外壳（Launcher 模式，不改变内核版本）..."

chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${ETC_DIR}" 2>/dev/null || true
chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${VAR_DIR}" 2>/dev/null || true
chmod 755 "${ETC_DIR}" 2>/dev/null || true
# VAR_DIR 收敛为最小权限(目录 750/文件 640/Token 600),不再递归 755
secure_var_perms

# 停止旧监督者(统一 supervisor.pid 口径;监督者 TERM 会级联停内核并回收 pip)
stop_supervisor

if [ ! -d "${VENV_DIR}" ]; then
    log_msg "venv 缺失，重建虚拟环境 ${VENV_DIR}..."
    if ! "${PYTHON_BIN}" -m venv "${VENV_DIR}"; then
        log_msg "ERROR: 虚拟环境创建失败: ${VENV_DIR}"
        notify_user "QwenPaw 虚拟环境创建失败，请检查 Python 运行环境与磁盘权限。"
        exit 1
    fi
    chmod -R 750 "${VENV_DIR}" 2>/dev/null || true  # 仅属主访问(审查 S3)
    if ! source "${VENV_DIR}/bin/activate"; then
        log_msg "ERROR: 虚拟环境激活失败: ${VENV_DIR}"
        notify_user "QwenPaw 虚拟环境激活失败，请检查运行环境完整性。"
        exit 1
    fi

    PYPI_MIRROR="${wizard_pypi_mirror:-aliyun}"
    MIRROR_URL="$(map_mirror_url "${PYPI_MIRROR}")"
    PIP_OPTS=""
    [ -n "${MIRROR_URL}" ] && PIP_OPTS="-i ${MIRROR_URL}"
    sync_pip_mirror "${PYPI_MIRROR}" 1

    # 按版本钉恢复内核；无钉时按向导渠道（stable/beta）。
    if VERSION_PIN="$(read_valid_version_pin "${PIN_FILE}")"; then
        TARGET_PKG="qwenpaw==${VERSION_PIN}"
        log_msg "按版本钉恢复内核: ${TARGET_PKG}"
    elif [ -f "${PIN_FILE}" ]; then
        TARGET_PKG="qwenpaw"
        log_msg "WARN: 版本钉内容非法，按向导渠道安装"
    else
        TARGET_PKG="qwenpaw"
        if [ "${wizard_channel:-stable}" = "beta" ]; then
            TARGET_PKG="--pre qwenpaw"
        fi
        log_msg "无版本钉，按向导渠道安装: ${TARGET_PKG}"
    fi

    PIP_LOG=$(mktemp)
    if ! python3 -m pip install ${TARGET_PKG} $PIP_OPTS > "${PIP_LOG}" 2>&1; then
        cat "${PIP_LOG}" >> "${LIB_LOG_FILE}"
        ERROR_MSG=$(tail -n 1 "${PIP_LOG}")
        rm -f "${PIP_LOG}"
        log_msg "ERROR: pip 安装失败: ${ERROR_MSG}"
        notify_user "QwenPaw 运行环境恢复失败: ${ERROR_MSG}"
        exit 1
    fi
    cat "${PIP_LOG}" >> "${LIB_LOG_FILE}"
    rm -f "${PIP_LOG}"
else
    log_msg "venv 已存在，内核版本保持不变（升级内核请在控制台「版本管理」中显式操作）"
fi

# 刷新版本钉：记录 venv 中当前实际内核版本(白名单校验 + 原子写入)
CUR_VER="$("${VENV_DIR}/bin/python3" -c "import importlib.metadata as m; print(m.version('qwenpaw'))" 2>/dev/null || true)"
if [ -n "${CUR_VER}" ] && valid_version_pin "${CUR_VER}"; then
    if write_version_pin "${CUR_VER}"; then
        log_msg "当前内核版本: ${CUR_VER}（版本钉已更新）"
    else
        log_msg "WARN: 版本钉写入失败: ${CUR_VER}"
    fi
fi

chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${WORKING_DIR}" 2>/dev/null || true
chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${VAR_DIR}" 2>/dev/null || true
chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${ETC_DIR}" 2>/dev/null || true
chmod -R 750 "${WORKING_DIR}" 2>/dev/null || true  # 会话记忆仅属主可读,不对同机其他用户放行(审查 S3)
secure_var_perms

MAIN_SCRIPT="${TRIM_APPDEST}/cmd/main"
[ ! -x "${MAIN_SCRIPT}" ] && MAIN_SCRIPT="/var/apps/qwenpaw/cmd/main"
if [ -x "${MAIN_SCRIPT}" ]; then
    log_msg "正在恢复 QwenPaw 监督者与内核服务..."
    if ! bash "${MAIN_SCRIPT}" start; then
        log_msg "ERROR: 升级后服务恢复失败"
        notify_user "QwenPaw 外壳已升级，但服务恢复失败，请检查 supervisor.log。"
        exit 1
    fi
else
    log_msg "ERROR: 未找到服务启动入口: ${MAIN_SCRIPT}"
    notify_user "QwenPaw 外壳已升级，但启动入口缺失，请在应用中心手动启动。"
    exit 1
fi

log_msg "QwenPaw 外壳升级完成！"
exit 0
