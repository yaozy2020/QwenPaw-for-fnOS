#!/bin/bash

PYTHON_BIN="/var/apps/python312/target/bin/python3"

# 公共环境与工具函数（路径/运行环境变量/log_msg/内核检测），HOME 为安装态语义
. "$(dirname "$0")/lib.sh"
LIB_LOG_FILE="${VAR_DIR}/qwenpaw-install.log"
export HOME="${WORKING_DIR}"

MARKER="${WORKING_DIR}/.qwenpaw_keep_runtime"
if [ -f "${MARKER}" ]; then
    log_msg "检测到保留运行环境标记，跳过安装，仅修正权限"
    exit 0
fi


# 1. 提取并持久化安装向导中设置的端口，同步至飞牛系统元数据
INIT_PORT="${wizard_port:-${service_port:-${wizard_service_port:-18088}}}"
if [ "${INIT_PORT}" = "19091" ]; then INIT_PORT="18088"; fi
if echo "${INIT_PORT}" | grep -qE '^[0-9]+$' && [ "${INIT_PORT}" -ge 1024 ] && [ "${INIT_PORT}" -le 65535 ]; then
    mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true
    echo "${INIT_PORT}" > "${TRIM_PKGVAR}/service_port"
    
    for ui_cfg in "${TRIM_APPDEST}/ui/config" "/var/apps/qwenpaw/ui/config"; do
        if [ -w "${ui_cfg}" ]; then
            sed -i 's/"port": *"[0-9]*"/"port": "'"${INIT_PORT}"'"/g' "${ui_cfg}" 2>/dev/null || true
        fi
    done
    for mf in "${TRIM_APPDEST}/manifest" "/var/apps/qwenpaw/manifest"; do
        if [ -w "${mf}" ]; then
            sed -i 's/^service_port *= *[0-9]*/service_port               = '"${INIT_PORT}"'/g' "${mf}" 2>/dev/null || true
        fi
    done
    log_msg "安装端口已设定并同步为: ${INIT_PORT}"
fi

log_msg "开始安装 QwenPaw (纯净 Launcher 模式)..."

# 运行环境与内核均健在 → 外壳升级/重装不重装内核（版本双轨制），仅刷新版本钉
# （MARKER 在 TRIM_PKGHOME 下会随 fpk 升级被清掉，因此以 venv 实际状态为准）
if [ -x "${VENV_DIR}/bin/python3" ] && "${VENV_DIR}/bin/python3" -c "import importlib.metadata as m; m.version('qwenpaw')" >/dev/null 2>&1; then
    CUR_VER="$("${VENV_DIR}/bin/python3" -c "import importlib.metadata as m; print(m.version('qwenpaw'))" 2>/dev/null || true)"
    log_msg "检测到运行环境与内核（${CUR_VER:-?}）均健在，跳过内核重装（双轨制：内核升级请走控制台版本管理）"
    if [ -n "${CUR_VER}" ]; then
        echo "${CUR_VER}" > "${VAR_DIR}/qwenpaw-version"
        log_msg "已刷新内核版本钉: ${CUR_VER}"
    fi
    log_msg "QwenPaw 外壳升级完成（内核未变更）！"
    exit 0
fi

log_msg "正在创建虚拟环境..."
"${PYTHON_BIN}" -m venv "${VENV_DIR}"
log_msg "虚拟环境 ${VENV_DIR} 创建成功"
chmod -R 755 "${VENV_DIR}" 2>/dev/null || true

log_msg "正在激活虚拟环境..."
source "${VENV_DIR}/bin/activate"
log_msg "虚拟环境激活成功"

PYPI_MIRROR="${wizard_pypi_mirror:-tsinghua}"
PIP_OPTS=""

if [ "$PYPI_MIRROR" = "tsinghua" ]; then
    log_msg "使用清华源安装"
    PIP_OPTS="-i https://pypi.tuna.tsinghua.edu.cn/simple"
elif [ "$PYPI_MIRROR" = "aliyun" ]; then
    log_msg "使用阿里云源安装"
    PIP_OPTS="-i https://mirrors.aliyun.com/pypi/simple/"
elif [ "$PYPI_MIRROR" = "ustc" ]; then
    log_msg "使用中科大源安装"
    PIP_OPTS="-i https://pypi.mirrors.ustc.edu.cn/simple/"
fi

# 向导选择的下载源落盘为控制台初始默认(控制台"下载源"选择器可随时改写;
# 仅在文件不存在时落盘,不覆盖用户已有选择 —— 源选择自此不再止步于安装时)
case "$PYPI_MIRROR" in
    tsinghua) MIRROR_URL="https://pypi.tuna.tsinghua.edu.cn/simple" ;;
    aliyun)   MIRROR_URL="https://mirrors.aliyun.com/pypi/simple/" ;;
    ustc)     MIRROR_URL="https://pypi.mirrors.ustc.edu.cn/simple/" ;;
    *)        MIRROR_URL="" ;;
esac
if [ -n "$MIRROR_URL" ] && [ ! -f "${VAR_DIR}/pip-mirror" ]; then
    printf '%s\n' "$MIRROR_URL" > "${VAR_DIR}/pip-mirror" 2>/dev/null || true
fi

log_msg "正在升级虚拟环境 pip..."
python3 -m pip install --upgrade pip $PIP_OPTS
log_msg "虚拟环境 pip 升级成功"

# 内核版本来源（修复路径）：版本钉优先，精确恢复用户选择的版本
VERSION_PIN="$(tr -d '[:space:]' < "${VAR_DIR}/qwenpaw-version" 2>/dev/null | sed -E 's/^[Vv]ersion:?//' || true)"
if [ -n "${VERSION_PIN}" ]; then
    TARGET_PKG="qwenpaw==${VERSION_PIN}"
    log_msg "检测到内核版本钉，按其精确恢复: ${TARGET_PKG}"
else
    # 首次安装不预装内核（对齐 DSH 模式）：由用户打开控制台「版本更新」自选版本安装
    log_msg "首次安装完成（外壳）。内核未预装——请打开 QwenPaw 控制台，在「版本更新」中选择版本安装。"
    log_msg "提示: 内核 wheel 约 40MB，控制台安装时从所选 PyPI 镜像下载。"
    chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${WORKING_DIR}" 2>/dev/null || true
    chmod -R 755 "${WORKING_DIR}" 2>/dev/null || true
    log_msg "QwenPaw 安装成功！（内核待控制台安装）"
    exit 0
fi

log_msg "正在通过 PyPI 镜像源在线安装 QwenPaw 核心引擎..."
PIP_LOG=$(mktemp)

log_msg "安装目标包: ${TARGET_PKG}，使用选项: ${PIP_OPTS}"
if ! python3 -m pip install --upgrade ${TARGET_PKG} $PIP_OPTS > "${PIP_LOG}" 2>&1; then
    cat "${PIP_LOG}" >> "${LIB_LOG_FILE}"
    ERROR_MSG=$(tail -n 1 "${PIP_LOG}")
    rm -f "${PIP_LOG}"
    log_msg "ERROR: pip 安装失败: ${ERROR_MSG}"
    notify_user "QwenPaw 内核安装失败: ${ERROR_MSG}。请在控制台「版本更新」中重试。"
    exit 1
fi
cat "${PIP_LOG}" >> "${LIB_LOG_FILE}"
rm -f "${PIP_LOG}"

# 记录内核版本钉：fpk 升级若重建 venv，按此版本恢复，不追踪最新
CUR_VER="$(python3 -c "import importlib.metadata as m; print(m.version('qwenpaw'))" 2>/dev/null || true)"
if [ -n "${CUR_VER}" ]; then
    echo "${CUR_VER}" > "${VAR_DIR}/qwenpaw-version"
    log_msg "已记录内核版本钉: ${CUR_VER}"
fi

log_msg "正在初始化 QwenPaw..."
echo "Yes" | python3 -m qwenpaw init --defaults

chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${WORKING_DIR}" 2>/dev/null || true
chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${TRIM_PKGVAR}" 2>/dev/null || true
chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${TRIM_PKGETC}" 2>/dev/null || true
chmod -R 755 "${WORKING_DIR}" 2>/dev/null || true
chmod -R 755 "${TRIM_PKGVAR}" 2>/dev/null || true
chmod -R 755 "${TRIM_PKGETC}" 2>/dev/null || true

log_msg "QwenPaw 安装成功！"
exit 0
